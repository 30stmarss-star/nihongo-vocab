{
    "manifest_version":  3,
    "name":  "packagerdiag",
    "version":  "1.0",
    "description":  "Static popup control for Safari Web Extension packaging.",
    "icons":  {
                  "16":  "icons/icon-16.png",
                  "32":  "icons/icon-32.png",
                  "128":  "icons/icon-128.png",
                  "512":  "icons/icon-512.png",
                  "1024":  "icons/icon-1024.png"
              },
    "action":  {
                   "default_title":  "packagerdiag",
                   "default_popup":  "popup.html"
               }
}
